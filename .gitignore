# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# Virtual environments. The name below is what BUILD.md and README.md
# tell a fresh clone to create; the others are common alternatives.
venv/
.venv/
env/
ENV/

# --- Test and tooling caches ------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- PyInstaller ------------------------------------------------------
# ``build.spec`` IS tracked -- it is the build recipe and belongs in the
# repo. What PyInstaller *produces* from it does not: ``build/`` is a
# throwaway work directory and ``dist/`` holds a ~70 MB binary that is
# regenerated by ``pyinstaller build.spec`` on any machine.
build/
dist/
*.manifest

# Inno Setup output. ``installer.iss`` is tracked, the Setup.exe it
# compiles is not.
installer_output/
Output/
*Setup.exe

# --- Alfred's own runtime data ----------------------------------------
# The dev-mode database, settings file and backups are personal data,
# created on first run. ``data/.gitkeep`` is tracked so the directory
# exists on a fresh clone; nothing inside it is.
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.alfred.db

# --- Editors and OS ---------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
